diff --git a/librz/arch/p/analysis/analysis_wasm.c b/librz/arch/p/analysis/analysis_wasm.c
index 2b937b095f..1642a21b03 100644
--- a/librz/arch/p/analysis/analysis_wasm.c
+++ b/librz/arch/p/analysis/analysis_wasm.c
@@ -10,17 +10,215 @@
 #undef RZ_IPI
 #define RZ_IPI static
 #include "../../bin/format/wasm/wasm.h"
+#define WASM_NO_SCOPE
 #include "wasm/wasm.c"
 
 #define WASM_STACK_SIZE 256
 
+typedef struct {
+	ut64 addr;
+	ut32 len;
+	ut8 *buf;
+	WasmScopeIndex *idx;
+} WasmIndexJob;
+
+static bool wasm_index_job(void *element, void *user) {
+	WasmIndexJob *job = element;
+	(void)user;
+	job->idx = wasm_scope_index_new(job->buf, (int)job->len);
+	free(job->buf);
+	job->buf = NULL;
+	return true;
+}
+
+static int wasm_sym_addr_cmp(const void *a, const void *b) {
+	const RzBinSymbol *sa = *(const RzBinSymbol *const *)a;
+	const RzBinSymbol *sb = *(const RzBinSymbol *const *)b;
+	if (sa->paddr < sb->paddr) {
+		return -1;
+	}
+	if (sa->paddr > sb->paddr) {
+		return 1;
+	}
+	return 0;
+}
+
+static int wasm_func_cmp(const void *a, const void *b) {
+	const WasmFuncScope *fa = a;
+	const WasmFuncScope *fb = b;
+	if (fa->addr < fb->addr) {
+		return -1;
+	}
+	if (fa->addr > fb->addr) {
+		return 1;
+	}
+	return 0;
+}
+
+static WasmFuncScope *wasm_find_func(WasmContext *ctx, ut64 addr) {
+	st32 lo, hi, best;
+	if (!ctx || !ctx->funcs || !ctx->n_funcs) {
+		return NULL;
+	}
+	lo = 0;
+	hi = (st32)ctx->n_funcs - 1;
+	best = -1;
+	while (lo <= hi) {
+		st32 mid = lo + (hi - lo) / 2;
+		if (ctx->funcs[mid].addr <= addr) {
+			best = mid;
+			lo = mid + 1;
+		} else {
+			hi = mid - 1;
+		}
+	}
+	if (best < 0) {
+		return NULL;
+	}
+	if (addr >= ctx->funcs[best].addr + ctx->funcs[best].len) {
+		return NULL;
+	}
+	return &ctx->funcs[best];
+}
+
+static void wasm_ensure_index(RzAnalysis *analysis, WasmContext *ctx) {
+	RzBinObject *obj;
+	const RzPVector *syms;
+	RzPVector *jobs;
+	void **it;
+	bool va = false;
+	ut32 ncalls = 0, cap = 0, nfuncs = 0;
+	if (!ctx || ctx->indexed) {
+		return;
+	}
+	ctx->indexed = true;
+	if (!analysis->binb.get_bin_object || !analysis->iob.read_at) {
+		return;
+	}
+	obj = analysis->binb.get_bin_object(analysis->binb.bin);
+	if (!obj) {
+		return;
+	}
+	syms = rz_bin_object_get_symbols(obj);
+	if (!syms) {
+		return;
+	}
+	if (analysis->coreb.cfggeti && analysis->coreb.core) {
+		va = analysis->coreb.cfggeti(analysis->coreb.core, "io.va") != 0;
+	}
+	jobs = rz_pvector_new(free);
+	if (!jobs) {
+		return;
+	}
+	/* Wasm function index: imported FUNC symbols in encounter order, then
+	 * defined functions by body address. Symbol-vector order is not that index. */
+	RzPVector *imps = rz_pvector_new(NULL);
+	RzPVector *defs = rz_pvector_new(NULL);
+	if (!imps || !defs) {
+		rz_pvector_free(imps);
+		rz_pvector_free(defs);
+		rz_pvector_free(jobs);
+		return;
+	}
+	rz_pvector_foreach (syms, it) {
+		RzBinSymbol *sym = *it;
+		if (!sym || !sym->name || !sym->type || strcmp(sym->type, "FUNC")) {
+			continue;
+		}
+		if (sym->is_imported) {
+			rz_pvector_push(imps, sym);
+		} else {
+			rz_pvector_push(defs, sym);
+		}
+	}
+	if (rz_pvector_len(defs) > 1) {
+		qsort(rz_pvector_data(defs), rz_pvector_len(defs), sizeof(void *), wasm_sym_addr_cmp);
+	}
+	for (int pass = 0; pass < 2; pass++) {
+		RzPVector *group = pass == 0 ? imps : defs;
+		rz_pvector_foreach (group, it) {
+			RzBinSymbol *sym = *it;
+			ut64 addr;
+			WasmIndexJob *job;
+			addr = va ? rz_bin_object_get_vaddr(obj, sym->paddr, sym->vaddr) : sym->paddr;
+			if (ncalls == cap) {
+				ut32 ncap = cap ? cap * 2 : 16;
+				ut64 *nc = realloc(ctx->calls, ncap * sizeof(ut64));
+				if (!nc) {
+					break;
+				}
+				ctx->calls = nc;
+				cap = ncap;
+			}
+			ctx->calls[ncalls++] = addr == UT64_MAX ? 0 : addr;
+			if (sym->is_imported || !sym->size || sym->size > 32 * 1024 * 1024 || addr == UT64_MAX) {
+				continue;
+			}
+			job = RZ_NEW0(WasmIndexJob);
+			if (!job) {
+				continue;
+			}
+			job->addr = addr;
+			job->len = (ut32)sym->size;
+			job->buf = malloc(job->len);
+			if (!job->buf || !analysis->iob.read_at(analysis->iob.io, addr, job->buf, job->len)) {
+				free(job->buf);
+				free(job);
+				continue;
+			}
+			rz_pvector_push(jobs, job);
+		}
+	}
+	rz_pvector_free(imps);
+	rz_pvector_free(defs);
+	ctx->n_calls = ncalls;
+	if (!rz_th_iterate_pvector(jobs, wasm_index_job, 0, NULL)) {
+		void **jit;
+		rz_pvector_foreach (jobs, jit) {
+			if (((WasmIndexJob *)*jit)->buf) {
+				wasm_index_job(*jit, NULL);
+			}
+		}
+	}
+	nfuncs = (ut32)rz_pvector_len(jobs);
+	if (nfuncs) {
+		ctx->funcs = calloc(nfuncs, sizeof(WasmFuncScope));
+		if (ctx->funcs) {
+			ut32 i = 0;
+			rz_pvector_foreach (jobs, it) {
+				WasmIndexJob *job = *it;
+				if (job->idx) {
+					ctx->funcs[i].addr = job->addr;
+					ctx->funcs[i].len = job->len;
+					ctx->funcs[i].idx = job->idx;
+					job->idx = NULL;
+					i++;
+				}
+			}
+			ctx->n_funcs = i;
+			qsort(ctx->funcs, ctx->n_funcs, sizeof(WasmFuncScope), wasm_func_cmp);
+		}
+	}
+	rz_pvector_foreach (jobs, it) {
+		WasmIndexJob *job = *it;
+		wasm_scope_index_free(job->idx);
+		free(job->buf);
+	}
+	rz_pvector_free(jobs);
+}
+
