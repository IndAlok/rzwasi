 	return op->len;
 }
 
+#ifndef WASM_NO_SCOPE
+typedef struct {
+	ut32 start;
+	ut32 end;
+	ut32 else_at;
+	st32 parent;
+	ut8 is_if;
+	ut8 is_loop;
+} WasmScope;
+
+struct wasm_scope_index_t {
+	WasmScope *s;
+	ut32 n;
+};
+
+static bool wasm_scope_grow(WasmScope **s, ut32 *cap, ut32 need) {
+	if (need <= *cap) {
+		return true;
+	}
+	ut32 ncap = *cap ? *cap * 2 : 16;
+	while (ncap < need) {
+		ncap *= 2;
+	}
+	WasmScope *ns = realloc(*s, ncap * sizeof(WasmScope));
+	if (!ns) {
+		return false;
+	}
+	*s = ns;
+	*cap = ncap;
+	return true;
+}
+
+void wasm_context_clear_cache(WasmContext *ctx) {
+	ut32 i;
+	if (!ctx) {
+		return;
+	}
+	if (ctx->funcs) {
+		for (i = 0; i < ctx->n_funcs; i++) {
+			wasm_scope_index_free(ctx->funcs[i].idx);
+		}
+		free(ctx->funcs);
+		ctx->funcs = NULL;
+	}
+	free(ctx->calls);
+	ctx->calls = NULL;
+	ctx->n_funcs = 0;
+	ctx->n_calls = 0;
+	ctx->indexed = false;
+}
+
+RZ_API WasmScopeIndex *wasm_scope_index_new(const ut8 *buf, int len) {
+	WasmScopeIndex *idx;
+	ut32 *stack = NULL, scap = 16, sp = 0, cap = 0, off = 0;
+	if (!buf || len < 1) {
+		return NULL;
+	}
+	idx = RZ_NEW0(WasmScopeIndex);
+	if (!idx || !wasm_scope_grow(&idx->s, &cap, 1)) {
+		wasm_scope_index_free(idx);
+		return NULL;
+	}
+	stack = malloc(scap * sizeof(ut32));
+	if (!stack) {
+		wasm_scope_index_free(idx);
+		return NULL;
+	}
+	idx->s[0].start = 0;
+	idx->s[0].end = UT32_MAX;
+	idx->s[0].else_at = UT32_MAX;
+	idx->s[0].parent = -1;
+	idx->s[0].is_if = 0;
+	idx->s[0].is_loop = 0;
+	idx->n = 1;
+	stack[sp++] = 0;
+	while (off < (ut32)len && sp > 0) {
+		WasmOp wop = { 0 };
+		int n = wasm_dis(&wop, buf + off, len - (int)off);
+		bool trap = wop.type == WASM_TYPE_OP_CORE && wop.op.core == WASM_OP_TRAP;
+		bool bad = !wop.txt || trap || !strcmp(wop.txt, "invalid");
+		ut8 core = (!bad && wop.type == WASM_TYPE_OP_CORE) ? (ut8)wop.op.core : 0;
+		free(wop.txt);
+		if (bad || n < 1) {
+			break;
+		}
+		if (core == WASM_OP_BLOCK || core == WASM_OP_LOOP || core == WASM_OP_IF) {
+			if (!wasm_scope_grow(&idx->s, &cap, idx->n + 1)) {
+				break;
+			}
+			if (sp == scap) {
+				ut32 *ns = realloc(stack, scap * 2 * sizeof(ut32));
+				if (!ns) {
+					break;
+				}
+				stack = ns;
+				scap *= 2;
+			}
+			idx->s[idx->n].start = off;
+			idx->s[idx->n].end = UT32_MAX;
+			idx->s[idx->n].else_at = UT32_MAX;
+			idx->s[idx->n].parent = (st32)stack[sp - 1];
+			idx->s[idx->n].is_if = core == WASM_OP_IF;
+			idx->s[idx->n].is_loop = core == WASM_OP_LOOP;
+			stack[sp++] = idx->n;
+			idx->n++;
+		} else if (core == WASM_OP_ELSE && sp > 0) {
+			WasmScope *top = &idx->s[stack[sp - 1]];
+			if (top->is_if && top->else_at == UT32_MAX) {
+				top->else_at = off;
+			}
+		} else if (core == WASM_OP_END && sp > 0) {
+			idx->s[stack[sp - 1]].end = off;
+			sp--;
+		}
+		off += (ut32)n;
+	}
+	free(stack);
+	return idx;
+}
+
+RZ_API void wasm_scope_index_free(WasmScopeIndex *idx) {
+	if (!idx) {
+		return;
+	}
+	free(idx->s);
+	free(idx);
+}
+
+RZ_API bool wasm_scope_index_query(const WasmScopeIndex *idx, ut32 from, ut32 depth, bool use_else, ut32 *jump_off) {
+	st32 best = -1;
+	ut32 i, d;
+	if (!idx || !jump_off) {
+		return false;
+	}
+	for (i = 0; i < idx->n; i++) {
+		const WasmScope *s = &idx->s[i];
+		if (s->end != UT32_MAX && s->start < from && from <= s->end) {
+			best = (st32)i;
+		}
+	}
+	if (best < 0) {
+		return false;
+	}
+	for (d = 0; d < depth; d++) {
+		best = idx->s[best].parent;
+		if (best < 0) {
+			return false;
+		}
+	}
+	if (idx->s[best].end == UT32_MAX) {
+		return false;
+	}
+	if (idx->s[best].is_loop) {
+		*jump_off = idx->s[best].start;
+	} else if (use_else && idx->s[best].else_at != UT32_MAX && idx->s[best].else_at >= from) {
+		*jump_off = idx->s[best].else_at + 1;
+	} else {
+		*jump_off = idx->s[best].end;
+	}
+	return true;
+}
+#endif
